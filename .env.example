# --- BOT ---
DEV_MODE=true
BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789

# --- DATABASE ---
DATABASE_URL=postgresql://bot_user:password123@localhost:5432/telegram_bot

# =========================================================
# ===================== BITRIX24 ==========================
# =========================================================

# Включить интеграцию Bitrix
BITRIX24_ENABLED=false

# Режим работы:
# false = webhook
# true  = OAuth (рекомендуется)
BITRIX24_USE_OAUTH=false


# ---------- WEBHOOK MODE ----------
# Формат:
# https://xxxxx.bitrix24.ru/rest/1/<webhook_token>
BITRIX24_WEBHOOK_URL=https://yourportal.bitrix24.ru/rest/1/your_webhook_code


# ---------- OAUTH MODE ----------
BITRIX24_PORTAL=yourportal.bitrix24.ru
BITRIX24_CLIENT_ID=local.xxxxxxxxxxxxxxxxx
BITRIX24_CLIENT_SECRET=your_client_secret
BITRIX24_REDIRECT_URI=https://your-domain.com/bitrix/oauth/callback

PUBLIC_BASE_URL=https://metri-bot.duckdns.org


# ---------- OPENLINES ----------
# Включает отправку сообщений в Открытые линии
BITRIX24_OPENLINES_ENABLED=true

# ID открытой линии (например: 68)
BITRIX24_OPENLINE_ID=1

# Код коннектора (обычно telegram_bot)
BITRIX24_CONNECTOR_ID=telegram_bot

# SOURCE_ID для CRM (если используется)
BITRIX24_TELEGRAM_SOURCE_ID=77777777777


# =========================================================
# ===================== FEATURES ==========================
# =========================================================
ENABLE_ADMIN_CHAT=true
AUTO_MIGRATE=true


# BITRIX24_LOG=off (или пусто/0/false) → никаких bitrix*.log
# BITRIX24_LOG=info (или 1/true/on) → пишет logs/bitrix.log
# BITRIX24_LOG=debug → пишет logs/bitrix.log + logs/bitrix_debug.log

BITRIX24_LOG=debug